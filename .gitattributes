# Normalize line endings across Windows/macOS build hosts.
* text=auto

# Shell/build scripts must stay LF everywhere (bash breaks on CRLF).
*.sh text eol=lf
*.mk text eol=lf
*.patch text eol=lf

# Windows batch files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.ttf binary
*.so binary
*.a binary
