diff --git a/libavformat/demux.c b/libavformat/demux.c
index 4fd22c4934..b5e188ce5e 100644
--- a/libavformat/demux.c
+++ b/libavformat/demux.c
@@ -301,7 +301,19 @@ int avformat_open_input(AVFormatContext **ps, const char *filename,
     if (s->pb)
         ff_id3v2_read_dict(s->pb, &si->id3v2_meta, ID3v2_DEFAULT_MAGIC, &id3v2_extra_meta);
 
-    if (ffifmt(s->iformat)->read_header)
+    /* ijk: demuxers that need the open options implement read_header2 */
+    if (ffifmt(s->iformat)->read_header2) {
+        AVDictionary *tmp2 = NULL;
+        if (options && *options)
+            av_dict_copy(&tmp2, *options, 0);
+        ret = ffifmt(s->iformat)->read_header2(s, &tmp2);
+        av_dict_free(&tmp2);
+        if (ret < 0) {
+            if (ffifmt(s->iformat)->flags_internal & FF_INFMT_FLAG_INIT_CLEANUP)
+                goto close;
+            goto fail;
+        }
+    } else if (ffifmt(s->iformat)->read_header)
         if ((ret = ffifmt(s->iformat)->read_header(s)) < 0) {
             if (ffifmt(s->iformat)->flags_internal & FF_INFMT_FLAG_INIT_CLEANUP)
                 goto close;
@@ -2529,6 +2541,62 @@ int avformat_find_stream_info(AVFormatContext *ic, AVDictionary **options)
     int64_t probesize = ic->probesize;
     int eof_reached = 0;
     int *missing_streams = av_opt_ptr(ic->iformat->priv_class, ic->priv_data, "missing_streams");
+    AVDictionaryEntry *md_t;
+
+    /* ijk: stop probing as soon as nb-streams streams got their start_time */
+    md_t = av_dict_get(ic->metadata, "nb-streams", NULL, AV_DICT_MATCH_CASE);
+    if (md_t) {
+        int nb_streams = (int) strtol(md_t->value, NULL, 10);
+        if (nb_streams > 0) {
+            int found_all_streams = 0;
+            read_size = 0;
+            while (!found_all_streams) {
+                if (read_size >= probesize) {
+                    av_log(ic, AV_LOG_INFO, "probe fail\n");
+                    return ic->nb_streams;
+                }
+
+                ret = read_frame_internal(ic, pkt1);
+                if (ret == AVERROR(EAGAIN))
+                    continue;
+                if (ret < 0) {
+                    /* EOF or error*/
+                    eof_reached = 1;
+                    break;
+                }
+
+                if (!(ic->streams[pkt1->stream_index]->disposition & AV_DISPOSITION_ATTACHED_PIC))
+                    read_size += pkt1->size;
+
+                if (!(ic->flags & AVFMT_FLAG_NOBUFFER)) {
+                    ret = avpriv_packet_list_put(&si->raw_packet_buffer,
+                                                 pkt1, NULL, 0);
+                    if (ret < 0)
+                        return ret;
+                }
+
+                for (unsigned j = 0; j < ic->nb_streams; j++) {
+                    int64_t cur_start_time = AV_NOPTS_VALUE;
+                    if (ic->streams[j]->start_time != AV_NOPTS_VALUE) {
+                        cur_start_time = av_rescale_q(ic->streams[j]->start_time,
+                                                      ic->streams[j]->time_base,
+                                                      AV_TIME_BASE_Q);
+                    }
+                    if (cur_start_time != AV_NOPTS_VALUE &&
+                        (ic->start_time == AV_NOPTS_VALUE || ic->start_time > cur_start_time)) {
+                       ic->start_time = cur_start_time;
+                    }
+                }
+
+                if (ic->nb_streams >= nb_streams && ic->start_time != AV_NOPTS_VALUE) {
+                    av_log(ic, AV_LOG_INFO, "probe pass\n");
+                    found_all_streams = 1;
+                }
+            }
+            av_dict_set_int(&ic->metadata, "nb-streams", 0, 0);
+            return ret < 0 ? ret : ic->nb_streams;
+        }
+    }
 
     flush_codecs = probesize > 0;
 
@@ -2631,6 +2699,20 @@ int avformat_find_stream_info(AVFormatContext *ic, AVDictionary **options)
 
             if (!has_codec_parameters(st, NULL))
                 break;
+            /* ijk: trust avg_frame_rate when caller opts out of fps probing */
+            if (ic->metadata) {
+                AVDictionaryEntry *fps_t = av_dict_get(ic->metadata, "skip-calc-frame-rate", NULL, AV_DICT_MATCH_CASE);
+                if (fps_t) {
+                    int fps_flag = (int) strtol(fps_t->value, NULL, 10);
+                    if (!st->r_frame_rate.num && st->avg_frame_rate.num > 0 && st->avg_frame_rate.den > 0 && fps_flag > 0) {
+                        int avg_fps = st->avg_frame_rate.num / st->avg_frame_rate.den;
+                        if (avg_fps > 0 && avg_fps <= 120) {
+                            st->r_frame_rate.num = st->avg_frame_rate.num;
+                            st->r_frame_rate.den = st->avg_frame_rate.den;
+                        }
+                    }
+                }
+            }
             /* If the timebase is coarse (like the usual millisecond precision
              * of mkv), we need to analyze more frames to reliably arrive at
              * the correct fps. */
